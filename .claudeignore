# .claudeignore — generated by claudectx
# Prevents Claude Code from accidentally reading large binary/generated files.
# Syntax is identical to .gitignore.

# Version control internals
.git/

# Dependencies
node_modules/
vendor/
.venv/
venv/
env/
.env/

# Build output
dist/
build/
out/
.next/
.nuxt/
.output/
target/

# Bytecode & compiled files
*.pyc
*.pyo
__pycache__/
*.class
*.o
*.a
*.so
*.dylib

# Logs & databases
*.log
logs/
*.sqlite3
*.sqlite
*.db

# OS artefacts
.DS_Store
Thumbs.db
desktop.ini

# Environment & secrets (never let Claude read these)
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
secrets.json

# Coverage & test caches
coverage/
.coverage
htmlcov/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Large media / binary assets
*.jpg
*.jpeg
*.png
*.gif
*.ico
*.mp4
*.mp3
*.pdf
*.zip
*.tar.gz
*.woff
*.woff2
*.ttf
*.eot

# Python / Django extras
migrations/
staticfiles/
media/
.eggs/
*.egg-info/
pip-wheel-metadata/
